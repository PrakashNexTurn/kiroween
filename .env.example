# Kiro Project Orchestrator Environment Configuration
# Copy this file to .env and customize as needed

# Server Configuration
KIRO_HOST=0.0.0.0
KIRO_PORT=8000
KIRO_WORKERS=1
KIRO_RELOAD=false

# Application Environment (development, production, testing)
KIRO_ENVIRONMENT=development
KIRO_DEBUG=false

# Logging Configuration
KIRO_LOG_LEVEL=INFO
KIRO_LOG_FILE=orchestrator.log
KIRO_LOG_MAX_BYTES=10485760
KIRO_LOG_BACKUP_COUNT=5

# Project Storage
# KIRO_BASE_PATH is the root directory where all projects are stored.
# Each project will have its own subdirectory: <base_path>/<project_id>/
# Within each project directory, specs are stored in: <project_id>/.kiro/specs/
# 
# Examples:
#   KIRO_BASE_PATH=.                    # Current directory (backward compatible)
#   KIRO_BASE_PATH=/home/user/projects  # Absolute path to projects directory
#   KIRO_BASE_PATH=./my-projects        # Relative path to projects directory
#
# Default: . (current directory)
KIRO_BASE_PATH=.

# CLI Configuration
KIRO_KIRO_CLI_COMMAND=kiro-cli
KIRO_CLI_TIMEOUT=

# API Configuration
KIRO_API_TITLE=Kiro Project Orchestrator
KIRO_API_VERSION=1.0.0
KIRO_API_DESCRIPTION=Backend system for automating software project lifecycles

# CORS Configuration
KIRO_CORS_ENABLED=true
KIRO_CORS_ORIGINS=["*"]
